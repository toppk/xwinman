"Resize"	f.resize
"Move"		f.move
""		f.nop
"Raise"		f.raise
"Lower"		f.lower
"Nail"		f.nail
"Focus"		f.focus
""		f.nop
"Fullzoom"	f.fullzoom
"Horizoom"	f.horizoom
"Vertzoom"	f.zoom
""		f.nop
"Kill"		f.destroy
"Delete"	f.delete
