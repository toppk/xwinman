#define Virtual desktop
VirtualDesktop"137x106-0+0" 17
#movement within vdesk
PanDistanceX 100
PanDistanceY 100
#AutoPan 5
OpaqueMove
IconDirectory		"/usr/local/include/X11/bitmaps"
FramePadding    1
#SqueezeTitle		#Makes a little Tittle Bar!!!
IconRegion  "100x100+1+25" North West 1 25  # where Icons to be sent
SortIconManager        
IconManagerGeometry     "=137x144-0+128" 1     
NoDefaults             
ShowIconManager        
NoSaveUnders            
NoGrabServer		# tell windowmgr to leave the sever alone if the sever is busy
RestartPreviousState   
DecorateTransients	# let transients have a title bar (for whatits worth)
XorValue        1		# something to do with window resizing
BorderWidth     1       
IconBorderWidth 1
ButtonIndent    1       
TitleButtonBorderWidth 1        
InterpolatemenuColors	# fancy graded menu colours
NoCaseSensitive         
Zoom            100		# fancy iconifying effect
IconifyByUnMapping

Pixmaps
{
	VirtualBackgroundPixmap "dimple1"
	RealScreenPixmap "dimple1"
}

