}
menu    "VTWM Control"
{
"VTWM Control"		f.title
"Refresh"		f.refresh
"Restart"		f.twmrc
"Show Icon Mgr"		f.showiconmgr
"Hide Icon Mgr"		f.hideiconmgr
"Windows"		( "green3" : "black")	f.menu "TwmWindows"
"Kill"			( "white" : "black" )	f.destroy
"EXIT"			( "white" : "black" )	f.quit

}
menu    "WindowOps"
{
        "Window Ops"    f.title
"Close"                 f.iconify
"Fullsize"              f.fullzoom
"Zoom"                  f.zoom
"Focus"                 f.focus
"Unfocus"               f.unfocus
"(De)Iconify"           f.iconify
"DeIconify"             f.deiconify
"Identify"              f.identify
"======="      f.title
"Delete"                f.delete
"Destroy"               f.destroy
}
TitleButtonBorderWidth 0
LeftTitleButton "menu12" = f.iconify
LeftTitleButton "xlogo11" = f.delete
RightTitleButton "rdblarrow" = f.function "ResizeOrClose"

Function        "ResizeOrClose"
{
        f.resize
}
Function        "RaiseOrMove"
{
        f.move
        f.deltastop
        f.raiselower
}
