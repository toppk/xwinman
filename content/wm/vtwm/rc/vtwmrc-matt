IconManagerFont "-adobe-times-*-r-normal-*-12-*-*-*-*"
   

Button1 =       : root  : f.menu "Menus"
Button2 =       : root  : f.menu "Tools"
Button3 =       : root  : f.menu "VTWM Control"

Button1 =       : door  : f.enterdoor 
Button2 =       : door  : f.enterdoor
Button3 =       : door  : f.enterdoor

Button1 =       : t|f   : f.function "RaiseOrMove"
Button2 =       : t|f   : f.menu     "WindowOps"
Button3 =       : t|f   : f.function "ResizeOrClose"

Button1 =       : d     : f.movescreen
Button2 =       : v     : f.movescreen
Button3 =       : d     : f.function "RaiseOrMove"

Button1 =       : m     : f.iconify
Button2 =       : m     : f.menu     "WindowOps"
Button3 =       : m     : f.raise

Button1 =       : i     : f.function "IconifyOrMove"
Button2 =       : i     : f.menu     "WindowOps"
Button3 =       : i     : f.function "ResizeOrClose"

Button1 = s     : w     : f.function "RaiseOrMove"
Button2 = s     : w     : f.menu "Menus"
Button3 = s     : w     : f.function "ResizeOrClose"

Button1 = m     : w     : f.iconify
Button2 = m     : w     : f.winrefresh
Button3 = m     : w     : f.autoraise

"F1" =                  : all   : f.setrealscreen "+0+0"
"F2" =                  : all   : f.setrealscreen "+1152+0"
"F3" =                  : all   : f.setrealscreen "+0+900"
"F4" =                  : all   : f.setrealscreen "+1152+900"

"F5" =          : all   : f.refresh
"F6" =          : all   : f.winrefresh

"F10" =                 : w             : f.version

"Left" = c              : all   : f.panleft "10"
"Right" = c             : all   : f.panright "10"
"Up" = c                : all   : f.panup "10"
"Down" = c              : all   : f.pandown "10"


menu    "Menus"
{
"Login at"	f.title
"Local"		!"xterm  -sb +si -rw -aw -bg yellow -fg black -geometry 75x24 &"
"lily"	!"xrsh lily xterm -T 'lily' -sb +si -rw -aw -bg 'dark orange' -fg 'dark slate gray' -geometry 75x24 &"
"holly" !"xrsh holly xterm -sb +si -rw -aw -bg chartreuse -fg black -geometry 75x24 &"
"crocus"	!"xrsh crocus xterm -T 'crocus' -sb +si -rw -aw -bg 'cornflower blue' -fg 'midnight blue' -geometry 75x24 &"
"Games"         ( "green3" : "black" )  f.menu "S_Games"
}
menu    "S_Games"
{
"System Games" 		f.title
"Xboard"		!"/usr/local/games/xboard &"
"Tetris"		!"/usr/local/games/tetris &"

}
menu "Tools"
{
"Tools"		f.title
"XLock"		!"xlock &"
"Ftptool"	!"ftptool &"
"XRN"		!"xrn &"
"Framemaker"	!"imaker"
"Xgopher"	!"xgopher &"
"XFontSel"	!"xfontsel &"
"OPAC"		!"xterm -T 'OPAC at the Library' -bg black -fg green -e telnet opac &"
"Xco"		!"xco -geometry 400x220 -show 16 &"
"XMan"		!"xman &"
"XWinInfo"	!"xwininfo &"
"BitmapEdit"	!"bitmap &"
"EditRes"	!"editres &"
"Floppies"	( "green3" : "black" )  f.menu "Floppies"
}
menu "Floppies"
{
"Floppies"      f.title
"Volcheck"       !"volcheck &"
"Eject"         !"eject fd &"
