# some simple default mouse bindings:
#   for the root window:
Mouse 1	RS   	A       Menu RootMenu Nop
Mouse 2	RS    	A      	Menu Window-Ops Nop
Mouse 3	RS    	A      	WindowList

#   for the title bar buttons:
Mouse 1 1      A       Menu RootMenu Nop
Mouse 2 1      A       Iconify
Mouse 3 1      A      	Menu Window-Ops2 Close
Mouse 1 3      A       Iconify
Mouse 1 5      A       ResizeMove br -130p -135p keep w+35p
Mouse 1 7      A       ResizeMove br -130p -65p keep w-35p
Mouse 1 9      A       Resize br keep -1p
Mouse 3 9      A       Resize br keep -100p
Mouse 1 2      A       Destroy
Mouse 1 4      A       Close
Mouse 1 6      A     	Maximize
Mouse 1 8      A       ResizeMove -1p -105p +0p +10p
Mouse 3 8      A       ResizeMove -1p -10p +0p +10p
Mouse 1 0      A       ResizeMove -130p -105p +0p +10p
Mouse 3 0      A       ResizeMove 60 50 +0p +10p

#   for other parts of the window/borders/icons:
Mouse 1 F       A       Move
Mouse 1 T       A       WindowShade toggle
Mouse 1 I       A       Iconify
Mouse 2 FT      A       Menu Window-Ops2 Nop
Mouse 2 I       A       Delete
Mouse 3 FTI     A       Resize-or-Raise

