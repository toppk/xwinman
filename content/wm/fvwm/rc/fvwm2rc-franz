################## FvwmButtons button-bar ################################
# Colors

*FvwmButtonsFore Black
*FvwmButtonsBack #908090

# Font
*FvwmButtonsFont -adobe-helvetica-bold-r-*-*-10-*-*-*-*-*-*-*
# Geometry - really likes to pick its own size, but giving a position is OK
*FvwmButtonsGeometry -1+1

# Layout: specify rows or columns, not both
*FvwmButtonsColumns 2
#*FvwmButtonsRows 2

# Define the buttons to use.....


*FvwmButtons(2x1) - whatever Swallow "FvwmPager" Module FvwmPager 0 0
*FvwmButtons(Swallow XClock 'Exec xclock -bg \#908090  -geometry -1500-1500 -padding 5 &')
*FvwmButtons(Swallow xbiff 'Exec xbiff -bg \#908090 -geometry -1500-1500 &')
*FvwmButtons XTerm xterm.xpm Exec "color_xterm" exec /usr/bin/X11/color_xterm -sb -sl 500 -j -ls -fn 10x20 -bg black -fg white -bd white &
*FvwmButtons XQC   rcalc.xpm   Exec "Xqc" xqc &
*FvwmButtons Netscape netscape3.xpm Exec "Netscape" exec netscape &    
*FvwmButtons PINE mail2.xpm Exec "pine" exec /usr/bin/X11/color_xterm -sb -sl 500 -j -ls -fn 10x20 -fg white -bg black -bd white -e pine & 
*FvwmButtons SLRN news.xpm Exec "slrn" exec /usr/bin/X11/color_xterm -sb -sl 500 -j -ls -fn 10x20 -fg white -bg black -bd white -e slrn & 
*FvwmButtons IRCII dragon.xpm Exec "irc" exec /usr/bin/X11/color_xterm -sb -sl 500 -j -ls -fn 10x20 -fg white -bg black -bd white -e irc _vicious_ sandiego.ca.us.undernet.org irc2.blackened.com & 
*FvwmButtons FileRunner xfm_icon.xpm Exec "FileRunner" exec fr &
*FvwmButtons EMACS emacs.xpm Exec "emacs" exec emacs &
*FvwmButtons LyX lyx.xpm Exec "LyX" lyx &
*FvwmButtons GIMP xpaint.xpm Exec "The Gimp" gimp &
*FvwmButtons XPat monalisa.xpm Exec "" xpat2 &
*FvwmButtons XKoules /usr/doc/koules/Koules.xpm Exec "Koules" xkoules &
*FvwmButtons xzx128 martini.xpm Exec "xzx" exec xzx128 &
*FvwmButtons Workman cdrom.xpm Exec "Workman" exec workman &
*FvwmButtons Kill    rbomb.xpm    Destroy
*FvwmButtons(Padding 5 10 Swallow xeyes 'Exec xeyes -bg \#908090 -geometry -1500-1500 &')

