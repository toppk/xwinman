Popup "Applications"
        Title	"Applications"
        Exec	"xv"		exec xv &
        Exec	"Bitmap"	exec bitmap -size 40x40 -geometry 650x650 &
        Exec	"Xxgdb"		exec xxgdb &
        Exec	"Calculator"	exec xcalc &
	Exec	"Oclock"	exec oclock &
EndPopup

Popup "Utilities"
	Title  "Utilities"
        Exec    "Top"           exec rxvt -T Top -n Top -e top &
        Exec    "Config"        exec xterm -T "vi(.steprc)" -e vi ~/.steprc &
EndPopup

Popup "Screen"
	Title	"Screen Savers"
	Exec 	"Blank"			exec xlock -nolock -nice 0 -mode blank &
	Exec 	"Flame"			exec xlock -nolock -nice 0 -mode flame &
	Exec 	"Hyper"			exec xlock -nolock -nice 0 -mode hyper &
	Exec 	"Pyro"			exec xlock -nolock -nice 0 -mode pyro &
	Exec 	"Rock"			exec xlock -nolock -nice 0 -mode rock &
	Exec 	"Rotor"			exec xlock -nolock -nice 0 -mode rotor &
	Exec 	"Swarm"			exec xlock -nolock -nice 0 -mode swarm &
	Exec 	"Worm"			exec xlock -nolock -nice 0 -mode worm &
EndPopup

# This menu is invoked as a sub-menu - it allows you to quit
Popup "Quit-Verify"
	Title	"Quit?"
	Quit	"Yes, Quit"
	Restart "Restart After Step"	afterstep
	Restart "Open Look WM"		olwm
        Restart "Restart Win95 Look"	fvwm95-2
	Restart "Restart Amiga Look"	amiwm
	Nop	"No, Don't"
EndPopup

Popup "Module-Popup"
	Title	"Modules"
	Module	"Identify"	FvwmIdent
        Module	"Wharf"		Wharf
EndPopup

# This menu will fire up some very common programs
Popup "HotList"
	Title 	"HotList"
        Exec    "Xterm"         exec color-xterm -sb -sl 500 -j -ls -fn 10x20  -geometry 80x40 -cr black -bg black -bd red -fg white &
        Exec    "Netscape"	exec /usr/X11/bin/Netscape/netscape -geometry 680x565 &
        Nop     ""
        Popup   "Applications"  Applications
        Popup   "ScreenSavers"  Screen
	Nop     ""
	Popup	"Utilities"	Utilities
 	Nop	""
        Popup   "Games"         Games
        Nop     ""
        Popup   "Modules"       Module-Popup
        Nop     ""
	Exec	"Xkill"		exec xkill &
	Nop	""
        Popup   "Exit" 	    Quit-Verify
EndPopup

# This defines the most common window operations
Popup "Window Ops"
        Title           "Window Ops"
        Function        "Move"          Move-or-Raise
        Function        "Resize"        Resize-or-Raise
        Raise           "Raise"
        Lower           "Lower"
	PutOnTop	"(Un)PutOnTop"
        Iconify         "(De)Iconify"
        Stick           "(Un)Stick"
        Function        "(Un)Maximize"  maximize_func
        Nop             ""
        Destroy         "Destroy"
        Close           "Close"
        Nop             ""
        Refresh         "Refresh Screen"
EndPopup

#ButtonStyle : 2 17 20x20@1 30x20@1 50x40@1 70x20@1 80x20@1 80x30@0 60x50@0 80x80@0 70x80@0 50x60@0 30x80@0 20x80@0 20x70@0 40x50@1 20x30@0 20x20@1

# First, for the mouse in the root window
# Button 1 gives the HotList menu
# Button 2 gives the WindowList menu
# Button 3 gives the WindowOps

Mouse 0         1       A       Iconify
Mouse 0         2       A       Close
Mouse 1		R   	A       PopUp "HotList"
Mouse 1		FS	A	Function "Resize-or-Raise"
Mouse 1		I	A	Function "Move-or-Iconify"
Mouse 1		T	A	Function "maximize_func"
Mouse 2         R       A       WindowList
Mouse 2		FST	A	PopUp "Window Ops"
Mouse 3		TSIF	A	RaiseLower
Mouse 3         R       A       PopUp "Window Ops"
Mouse 3         W       M       RaiseLower

# Keyboard accelerators
Key F1		A	M	Popup "HotList"
Key F2		A	M	Popup "Window Ops"
Key F3		A	M	WindowList
Key F4		A	M	Exec "xwd" xwd -root -out ~/screen.xwd &
Key F5 	        A	A       Iconify

# Arrow Keys
# press arrow + control anywhere, and scroll by 1 page
Key Left        A       C       Scroll -100 0
Key Right       A       C       Scroll +100 +0
Key Up          A       C       Scroll +0   -100
Key Down        A       C       Scroll +0   +100

