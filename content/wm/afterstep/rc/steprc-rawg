# NEXTSTEP(tm) look related stuff

Module Wharf 

*WharfGeometry -10+2
*WharfColumns 1 

*Wharf afterstep	AfterStep.xpm		Folder
 *Wharf config		interface.xpm		Exec "-" color-xterm +sb -j -ls -fn 10x20 -geometry 80x40+140+20 -cr black -ls -bg black -fg white -title "Configure .steprc" -name "Configure" -e joe -nobackups +wordwrap ~/.steprc &
 *Wharf Recycler	RecycleLogo.xpm		Restart " " afterstep
 *Wharf Shutdown	shutdown.xpm		Quit 
*Wharf ~Folder

*Wharf -		-			MaxSwallow "asclock" asclock -12 -shape &
*Wharf xmailbox		nil			MaxSwallow "xmailbox" xmailbox &
*Wharf CoNSoL3		NeXTterm5.xpm		Exec "-" ansi_xterm +sb -j -ls -fn VGA -geometry 80x25 -cr black -bg black -fg white -title "Console" -name "Console" &
*Wharf r00t_CoNSoL3	Television.xpm		Exec "-" ansi_xterm +sb -j -ls -fn VGA -geometry 80x25 -cr black -bg black -fg white -title "Root Console" -name "Root Console" -e su -l &

*Wharf Network		Networked.xpm		Folder
 *Wharf irc		MicroPhonePro.xpm	Exec "-" color-xterm -sb -sl 500 -j -ls -fn 10x20 -geometry 105x40+2+2 -cr black -bg black -bd red -fg white -title IRC -name irc -e irc &
 *Wharf Netscape	NetscapeLogo.xpm 	Exec "-" netscape & 
*Wharf ~Folder

*Wharf gimp 		PaintBrushSplash.xpm	Exec "-" gimp &

*Wharf Music		OldRadio.xpm		Folder
 *Wharf tracker		Speakers.xpm		Exec "-" xterm +sb -sl 500 -j -ls -fn 10x20  -geometry 20x4+2+810 -cr black -bg gray -fg black -title "Tracker" -name "Tracker" -e randmass tracker -quiet -stereo -tolerant /home/ftp/pub/Music/MODz/Rave-House-Techno/* &
 *Wharf CD_Player	ColoredCompactDisc.xpm	Exec "-" cdplayer &
 *Wharf xtmix		xtmix.xpm		Exec "-" xtmix &
*Wharf ~Folder

*Wharf Screen_Lock	KeysOnChain.xpm   	Exec "-" xlock -nice 0 -mode rock &

